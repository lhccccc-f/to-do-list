<Window
    x:Class="ToDoList.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ToDoList.Core.Models"
    xmlns:local="using:ToDoList.App"
    Title="to-do-list · 我的计划">
    <Grid x:Name="Root" Loaded="Root_Loaded">
        <Grid x:Name="MainPane" Padding="28,20,28,16" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid ColumnSpacing="16" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="我的计划" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="BookButton" Grid.Column="1" VerticalAlignment="Center" MaxWidth="250" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="ActiveBookName" Text="日历簿 1" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                            <FontIcon Glyph="&#xE70D;" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="BookFlyout" Opening="BookFlyout_Opening">
                                <StackPanel Spacing="10" Width="285">
                                    <TextBlock Text="日历簿" FontWeight="SemiBold" />
                                    <ScrollViewer MaxHeight="320">
                                        <StackPanel x:Name="BookList" Spacing="4" />
                                    </ScrollViewer>
                                    <Button Click="AddBook_Click" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="新增日历簿" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <Button x:Name="DoneButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center" Padding="24,11" Click="Done_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE73E;" FontSize="15" /><TextBlock Text="完成" /></StackPanel>
                </Button>
            </Grid>

            <Grid x:Name="Workspace" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CalendarColumn" Width="1*" MinWidth="290" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition x:Name="EditorColumn" Width="1.7*" MinWidth="480" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource PanelRadius}" Padding="18">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="MonthLabel" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource QuietButton}" Click="PreviousMonth_Click" ToolTipService.ToolTip="上个月" AutomationProperties.Name="上个月"><FontIcon Glyph="&#xE76B;" FontSize="13" /></Button>
                            <Button Grid.Column="2" Style="{StaticResource QuietButton}" Click="NextMonth_Click" ToolTipService.ToolTip="下个月" AutomationProperties.Name="下个月"><FontIcon Glyph="&#xE76C;" FontSize="13" /></Button>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="一" HorizontalAlignment="Center" Opacity="0.6" />
                            <TextBlock Grid.Column="1" Text="二" HorizontalAlignment="Center" Opacity="0.6" />
                            <TextBlock Grid.Column="2" Text="三" HorizontalAlignment="Center" Opacity="0.6" />
                            <TextBlock Grid.Column="3" Text="四" HorizontalAlignment="Center" Opacity="0.6" />
                            <TextBlock Grid.Column="4" Text="五" HorizontalAlignment="Center" Opacity="0.6" />
                            <TextBlock Grid.Column="5" Text="六" HorizontalAlignment="Center" Opacity="0.6" />
                            <TextBlock Grid.Column="6" Text="日" HorizontalAlignment="Center" Opacity="0.6" />
                        </Grid>
                        <Grid x:Name="CalendarGrid" Grid.Row="2" />
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="● 有计划   ·   方框标记今天" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="今天" Click="Today_Click" Style="{StaticResource QuietButton}" />
                        </Grid>
                    </Grid>
                </Border>

                <Thumb x:Name="Divider" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                       DragDelta="Divider_DragDelta" DragCompleted="Divider_DragCompleted"
                       AutomationProperties.Name="拖动调整日历和编辑区宽度" ToolTipService.ToolTip="左右拖动，调整编辑区宽度">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border Width="4" Height="52" CornerRadius="2" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" /></Grid></ControlTemplate></Thumb.Template>
                </Thumb>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource PanelRadius}" Padding="22">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="SelectedDateLabel" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectedWeekdayLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource QuietButton}" Click="PreviousDay_Click" VerticalAlignment="Center" ToolTipService.ToolTip="前一天" AutomationProperties.Name="前一天"><FontIcon Glyph="&#xE76B;" FontSize="14" /></Button>
                            <Button Grid.Column="2" Style="{StaticResource QuietButton}" Click="NextDay_Click" VerticalAlignment="Center" ToolTipService.ToolTip="后一天" AutomationProperties.Name="后一天"><FontIcon Glyph="&#xE76C;" FontSize="14" /></Button>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="10" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                            <TextBlock Text="排序" FontSize="12" Opacity="0.65" />
                            <TextBlock Grid.Column="1" Text="计划内容" FontSize="12" Opacity="0.65" />
                            <TextBlock Grid.Column="2" Text="预计用时" FontSize="12" Opacity="0.65" />
                        </Grid>
                        <ScrollViewer x:Name="PlanScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PlanRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlanItem">
                                        <Grid ColumnSpacing="10" Padding="0,0,0,10" AllowDrop="True" DragOver="Row_DragOver" Drop="Row_Drop" Tag="{Binding Id}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                            <Border CanDrag="True" DragStarting="Handle_DragStarting" Tag="{Binding Id}"
                                                    CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Height="38" VerticalAlignment="Top"
                                                    ToolTipService.ToolTip="拖动数字调整顺序" AutomationProperties.Name="拖动此序号调整顺序">
                                                <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBox Grid.Column="1" Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="写下这一项计划…" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="20000"
                                                     MinHeight="38" MaxHeight="260" VerticalAlignment="Top" AutomationProperties.Name="计划内容" />
                                            <TextBox Grid.Column="2" Text="{Binding Duration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="如：30分钟" MaxLength="200" MinHeight="38" VerticalAlignment="Top" AutomationProperties.Name="预计用时" />
                                            <Button Grid.Column="3" Tag="{Binding Id}" Click="DeleteRow_Click" VerticalAlignment="Top" Padding="8,10" Style="{StaticResource QuietButton}"
                                                    ToolTipService.ToolTip="删除这一行" AutomationProperties.Name="删除这一行"><FontIcon Glyph="&#xE74D;" FontSize="13" /></Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Grid Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Click="AddRow_Click" Padding="16,10"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="添加计划" /></StackPanel></Button>
                            <Button Grid.Column="1" Click="BatchSettings_Click" Padding="14,10" x:Name="BatchSettingsButton">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8FD;" FontSize="14" /><TextBlock Text="批量设置" /></StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="DeleteSelectedPlans_Click" Padding="14,10" HorizontalAlignment="Right" x:Name="DeleteSelectedPlansButton">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="批量删除" /></StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatus" Text="正在打开计划…" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="重试保存" x:Name="RetrySaveButton" Visibility="Collapsed" Click="RetrySave_Click" />
            </Grid>
        </Grid>
        <local:ExportView x:Name="ExportPane" Visibility="Collapsed" />
    </Grid>
</Window>

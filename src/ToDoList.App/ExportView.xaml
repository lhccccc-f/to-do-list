<UserControl
    x:Class="ToDoList.App.ExportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ToDoList.App">
    <Grid Padding="28,20,28,18" RowSpacing="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource QuietButton}" Click="Back_Click" VerticalAlignment="Center" ToolTipService.ToolTip="返回编辑" AutomationProperties.Name="返回编辑"><FontIcon Glyph="&#xE72B;" FontSize="18" /></Button>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="导出我的计划" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="BookLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="ExportForm" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid ColumnSpacing="22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" MinWidth="380" /><ColumnDefinition Width="1*" MinWidth="370" /></Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                    <StackPanel Spacing="16">
                        <TextBlock Text="选择日期" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="点击日期可逐个勾选或取消，支持不连续选择。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <local:DateSelectionView x:Name="ExportDates" />
                        <CheckBox x:Name="IncludeEmpty" Content="包含空白日期，留出手写空间" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                    <StackPanel Spacing="20">
                        <TextBlock Text="文件设置" FontSize="20" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="文件名" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="FileNameDisplay" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center"
                                           AutomationProperties.Name="当前文件名" />
                                <Button Grid.Column="1" x:Name="EditNameButton" Click="EditName_Click" Style="{StaticResource QuietButton}" VerticalAlignment="Top"
                                        ToolTipService.ToolTip="编辑文件名" AutomationProperties.Name="编辑文件名">
                                    <FontIcon Glyph="&#xE70F;" FontSize="16" />
                                </Button>
                                <Button Grid.Column="2" x:Name="ResetNameButton" Click="ResetName_Click" Style="{StaticResource QuietButton}" VerticalAlignment="Top"
                                        ToolTipService.ToolTip="重置默认文件名" AutomationProperties.Name="重置默认文件名">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                </Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="保存位置" />
                            <TextBox x:Name="FolderPath" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="导出文件夹" />
                            <Button Click="ChooseFolder_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="14" /><TextBlock Text="选择文件夹" /></StackPanel></Button>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="文件排版" />
                            <CheckBox x:Name="ShowCheckboxes" Content="显示空心打勾方框" IsChecked="True" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="导出格式" />
                            <CheckBox x:Name="WordFormat" Content="Word (.docx)" IsChecked="True" />
                            <CheckBox x:Name="PdfFormat" Content="PDF (.pdf)" IsChecked="True" />
                            <CheckBox x:Name="JpgFormat" Content="图片 (.jpg)" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            </ContentControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="10">
            <InfoBar x:Name="ExportNotice" IsOpen="False" IsClosable="True" />
            <StackPanel x:Name="ResultButtons" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><ProgressRing x:Name="ExportProgress" IsActive="False" Visibility="Collapsed" Width="22" Height="22" /><TextBlock x:Name="ExportStatus" Text="计划已保存，可以开始导出。" VerticalAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                <Button x:Name="ConfirmExportButton" Grid.Column="1" Content="确认导出" Padding="28,12" Style="{StaticResource AccentButtonStyle}" Click="ConfirmExport_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl
    x:Class="ToDoList.App.ExportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28,20,28,18" RowSpacing="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource QuietButton}" Click="Back_Click" VerticalAlignment="Center" ToolTipService.ToolTip="返回编辑" AutomationProperties.Name="返回编辑"><FontIcon Glyph="&#xE72B;" FontSize="18" /></Button>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="导出我的计划" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="选好日期，把计划变成一份可以打勾的清单。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ExportForm" ColumnSpacing="22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" MinWidth="380" /><ColumnDefinition Width="1*" MinWidth="370" /></Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                    <StackPanel Spacing="16">
                        <TextBlock Text="01   选择日期" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="点击日期可逐个勾选或取消，支持不连续选择。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CalendarView x:Name="ExportCalendar" SelectionMode="Multiple" FirstDayOfWeek="Monday" NumberOfWeeksInView="6"
                                      HorizontalAlignment="Stretch" SelectedDatesChanged="Dates_Changed" CalendarViewDayItemChanging="DayItem_Changing" />
                        <TextBlock Text="快速选择连续范围" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <CalendarDatePicker x:Name="RangeStart" Header="开始日期" HorizontalAlignment="Stretch" />
                            <CalendarDatePicker x:Name="RangeEnd" Grid.Column="1" Header="结束日期" HorizontalAlignment="Stretch" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="应用范围" Click="ApplyRange_Click" />
                            <Button Content="所在周" Click="SelectWeek_Click" />
                            <Button Content="清空" Click="ClearDates_Click" Style="{StaticResource QuietButton}" />
                        </StackPanel>
                        <TextBlock x:Name="SelectionSummary" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <CheckBox x:Name="IncludeEmpty" Content="包含空白日期，留出手写空间" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                    <StackPanel Spacing="20">
                        <TextBlock Text="02   文件设置" FontSize="20" FontWeight="SemiBold" />
                        <TextBox x:Name="FileNameInput" Header="文件名" PlaceholderText="不含扩展名" MaxLength="120" TextChanged="FileName_Changed" />
                        <StackPanel Spacing="8"><TextBlock Text="导出格式" /><StackPanel Orientation="Horizontal" Spacing="24"><CheckBox x:Name="WordFormat" Content="Word (.docx)" IsChecked="True" /><CheckBox x:Name="PdfFormat" Content="PDF (.pdf)" IsChecked="True" /></StackPanel></StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="保存位置" />
                            <TextBox x:Name="FolderPath" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="导出文件夹" />
                            <Button Click="ChooseFolder_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="14" /><TextBlock Text="选择文件夹" /></StackPanel></Button>
                        </StackPanel>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8"><TextBlock Text="打印排版" FontWeight="SemiBold" /><TextBlock Text="A4 纵向 · 26 磅居中标题&#xA;日期带星期 · 空心打勾方框&#xA;计划沿用编辑顺序 · 预计用时靠右" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        </Border>
                        <TextBlock Text="Word 可继续编辑，PDF 适合直接打印。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="10">
            <InfoBar x:Name="ExportNotice" IsOpen="False" IsClosable="True" />
            <StackPanel x:Name="ResultButtons" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><ProgressRing x:Name="ExportProgress" IsActive="False" Visibility="Collapsed" Width="22" Height="22" /><TextBlock x:Name="ExportStatus" Text="计划已保存，可以开始导出。" VerticalAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                <Button x:Name="ConfirmExportButton" Grid.Column="1" Content="确认导出" Padding="28,12" Style="{StaticResource AccentButtonStyle}" Click="ConfirmExport_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
